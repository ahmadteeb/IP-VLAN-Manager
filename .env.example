# App (Compose binds HOST to 0.0.0.0 and uses PORT as the published host port).
HOST=localhost
PORT=5000
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret

# Compose creates this MySQL database and application user on first startup.
MYSQL_DATABASE=ip_vlan_manager
MYSQL_USER=ip_vlan_user
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Both Python services use this URL. Keep it consistent with MYSQL_* above.
# URL-encode special characters in credentials when editing DATABASE_URL.
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# FTP inventory source (separate from the app's HOST).
FTP_HOST=ftp.example.com
FTP_USERNAME=replace-me
FTP_PASSWORD=replace-me

# Daily fetching start time (24-hour HH:MM) and IANA timezone.
FETCH_START_TIME=02:00
TZ=Asia/Amman
